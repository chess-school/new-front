# Фронтенд (Vite). Скопируйте в .env (или .env.production для сборки на сервере):
#   cp .env.example .env.production && npm ci && npm run build   -> статика в build/
# Переменные VITE_* вшиваются в сборку при npm run build — после смены пересоберите.
# Секретов сюда не кладите: всё, что здесь есть, увидит любой посетитель сайта.

# Адрес API бэкенда с /api на конце, без / после него. Клиент сам добавит /v2;
# сокеты чата и онлайн-партий подключаются к тому же хосту (namespace /chat и /play).
# Локально: http://localhost:3000/api (порт — PORT из backend/.env)
VITE_API_URL=https://api.example.com/api
